# Cross-build the user-space CLI on Windows/Linux with Zig's bundled libc++/glibc.
# OpenSSL must come from ARM64 Debian 12 packages, not the host installation.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT ZIG_EXECUTABLE OR NOT OPENSABBA_ARM64_OPENSSL_ROOT)
  message(FATAL_ERROR "Set ZIG_EXECUTABLE and OPENSABBA_ARM64_OPENSSL_ROOT")
endif()
set(CMAKE_CXX_COMPILER "${ZIG_EXECUTABLE}")
set(CMAKE_CXX_COMPILER_ARG1 "c++")
set(CMAKE_CXX_FLAGS_INIT
  "-target aarch64-linux-gnu.2.36 -isystem \"${OPENSABBA_ARM64_OPENSSL_ROOT}/usr/include/aarch64-linux-gnu\"")
set(CMAKE_CXX_ARCHIVE_CREATE "\"${ZIG_EXECUTABLE}\" ar qc <TARGET> <OBJECTS>")
set(CMAKE_CXX_ARCHIVE_FINISH "\"${ZIG_EXECUTABLE}\" ranlib <TARGET>")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
  ZIG_EXECUTABLE OPENSABBA_ARM64_OPENSSL_ROOT)

set(OPENSSL_INCLUDE_DIR "${OPENSABBA_ARM64_OPENSSL_ROOT}/usr/include" CACHE PATH "")
set(OPENSSL_SSL_LIBRARY
  "${OPENSABBA_ARM64_OPENSSL_ROOT}/usr/lib/aarch64-linux-gnu/libssl.so.3" CACHE FILEPATH "")
set(OPENSSL_CRYPTO_LIBRARY
  "${OPENSABBA_ARM64_OPENSSL_ROOT}/usr/lib/aarch64-linux-gnu/libcrypto.so.3" CACHE FILEPATH "")
set(LZ4_LIBRARY
  "${OPENSABBA_ARM64_OPENSSL_ROOT}/usr/lib/aarch64-linux-gnu/liblz4.so.1.9.4" CACHE FILEPATH "")
set(CMAKE_FIND_ROOT_PATH "${OPENSABBA_ARM64_OPENSSL_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
